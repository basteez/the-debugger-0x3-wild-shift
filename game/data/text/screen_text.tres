[gd_resource type="Resource" script_class="TextScreenText" load_steps=2 format=3]

[ext_resource type="Script" path="res://src/ui/text/text_screen_text.gd" id="1_tscreen"]

[resource]
script = ExtResource("1_tscreen")
title = "The Debugger 0x03: Wild Shift"
prompt = "press any key"
intro_captions = Array[PackedStringArray]([PackedStringArray("2 a.m.", "stuck on a bug"), PackedStringArray("squeeze", "QUACK"), PackedStringArray("The Clearing")])
dead_line = "Process exited with code 1"
new_run_label = "[N] new run"
debug_build_on_label = "[B] debug build on"
debug_build_off_label = "[B] debug build off"
practice_label = "[P] practice"
practice_hint = "[L / SELECT] loadout  [ESC / L3] title"
fullscreen_label = "[F] fullscreen"
windowed_label = "[F] windowed"
tutorial_label = "[T] tutorial"
tutorial_tests = PackedStringArray("test_move", "test_actions", "test_shift", "test_combo", "test_patch", "test_crit")
tutorial_prompts = PackedStringArray("Move with {move}. Walk around a little.", "{j} runs the left live bit, {k} the right one. Try both.", "{shift} shift the bits. Shift until the live bits read A D.", "{j} then {k}, quickly: Dash Strike. Hit the dummy with it.", "The ; is the only weak spot. Wait until it lights up,", "PATCHED = x1.5 damage for 3 s. Unpatched hits do only x0.5.")
tutorial_prompts_2 = PackedStringArray("Each test turns to [PASS] when you do it.", "The 2 left bits in the reg panel are live. A = slash, D = dash.", "Then {j} slashes and {k} dashes.", "A slash, then a dash right away: that is a combo.", "then hit it with a Dash Strike: it gets PATCHED.", "Hit it again now, while it is PATCHED.")
tutorial_hint_skip = "hold {skip}: skip"
tutorial_all_pass_1 = "ALL TESTS PASSED."
tutorial_all_pass_2 = "deploying to production..."
