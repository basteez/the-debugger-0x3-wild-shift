[gd_resource type="Resource" script_class="BossDef" format=3]

[ext_resource type="Script" path="res://src/bosses/framework/boss_def.gd" id="1_bdef"]
[ext_resource type="Script" path="res://src/bosses/framework/phase_def.gd" id="2_pdef"]
[ext_resource type="Script" path="res://src/bosses/framework/attack_def.gd" id="3_adef"]
[ext_resource type="Resource" path="res://data/bosses/segfault/attack_access_violation.tres" id="4_claw"]

[sub_resource type="Resource" id="Resource_phase1"]
script = ExtResource("2_pdef")
