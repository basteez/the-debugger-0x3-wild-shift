weak_window = Vector2i(2, 3)
gap_frames = 90
attack_pool = Array[ExtResource("3_adef")]([ExtResource("4_claw")])

[sub_resource type="Resource" id="Resource_phase2"]
script = ExtResource("2_pdef")
hp_threshold = 66
weak_window = Vector2i(4, 1)
gap_frames = 75
attack_pool = Array[ExtResource("3_adef")]([ExtResource("4_claw")])

[sub_resource type="Resource" id="Resource_phase3"]
script = ExtResource("2_pdef")
hp_threshold = 33
weak_window = Vector2i(3, 4)
gap_frames = 60
attack_pool = Array[ExtResource("3_adef")]([ExtResource("4_claw")])

[resource]
script = ExtResource("1_bdef")
boss_id = &"segfault"
name_signature = "segfault"
max_hp = 1000
phases = Array[ExtResource("2_pdef")]([SubResource("Resource_phase1"), SubResource("Resource_phase2"), SubResource("Resource_phase3")])
