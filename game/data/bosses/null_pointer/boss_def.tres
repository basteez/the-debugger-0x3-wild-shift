[sub_resource type="Resource" id="Resource_phase2"]
script = ExtResource("2_pdef")
hp_threshold = 50
weak_window = Vector2i(1, 2)
gap_frames = 60
attack_pool = Array[ExtResource("3_adef")]([ExtResource("4_grab"), ExtResource("5_rain")])

[resource]
script = ExtResource("1_bdef")
boss_id = &"null_pointer"
name_signature = "nullPointer"
max_hp = 700
phases = Array[ExtResource("2_pdef")]([SubResource("Resource_phase1"), SubResource("Resource_phase2")])
