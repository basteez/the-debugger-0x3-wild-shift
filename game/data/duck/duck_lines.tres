[gd_resource type="Resource" script_class="DuckLinesDef" load_steps=14 format=3]

[ext_resource type="Script" path="res://src/ui/duck/duck_lines_def.gd" id="1_dlines"]
[ext_resource type="Script" path="res://src/ui/duck/duck_line_def.gd" id="2_dline"]

[sub_resource type="Resource" id="Resource_intro"]
script = ExtResource("2_dline")
id = &"intro_handover"
text = "Quack. Explain the bug to me. Use these."

[sub_resource type="Resource" id="Resource_t1"]
script = ExtResource("2_dline")
id = &"t1_shift"
text = "Q or E shifts your bits. Go on, shift. It's waiting. Only the two on the left are live; the rest are in code review."

[sub_resource type="Resource" id="Resource_t2"]
script = ExtResource("2_dline")
id = &"t2_semicolon"
text = "See the semicolon? It's always the semicolon. Hit it when it opens."

[sub_resource type="Resource" id="Resource_t3"]
script = ExtResource("2_dline")
id = &"t3_dash_strike"
text = "J then K: Dash Strike. Two bits, one commit."

[sub_resource type="Resource" id="Resource_t4"]
script = ExtResource("2_dline")
id = &"t4_phase_two"
text = "It refactored itself. Have you tried shifting it off and on again?"

[sub_resource type="Resource" id="Resource_h1"]
script = ExtResource("2_dline")
id = &"harvest_shared"
text = "Bug squashed. It dropped a bit: new windows, new combos."

[sub_resource type="Resource" id="Resource_ending"]
script = ExtResource("2_dline")
id = &"ending"
text = "Quack. Works on your machine now."

[sub_resource type="Resource" id="Resource_hint_a_d"]
script = ExtResource("2_dline")
id = &"hint_a_d"
text = "Quack. Weak window: A→D."

[sub_resource type="Resource" id="Resource_hint_d_a"]
script = ExtResource("2_dline")
id = &"hint_d_a"
text = "Quack. Weak window: D→A."

[sub_resource type="Resource" id="Resource_hint_d_l"]
script = ExtResource("2_dline")
id = &"hint_d_l"
text = "Quack. Weak window: D→L."

[sub_resource type="Resource" id="Resource_hint_n_a"]
script = ExtResource("2_dline")
id = &"hint_n_a"
text = "Quack. Weak window: N→A."

[sub_resource type="Resource" id="Resource_hint_l_n"]
script = ExtResource("2_dline")
id = &"hint_l_n"
text = "Quack. Weak window: L→N."

[sub_resource type="Resource" id="Resource_n1"]
script = ExtResource("2_dline")
id = &"n1_breakpoint"
text = "Space: Breakpoint. Time stops, you shift. Finally, a debugger that works."

[sub_resource type="Resource" id="Resource_n2"]
script = ExtResource("2_dline")
id = &"n2_hold_r"
text = "Hold R. Pointers point *somewhere*."

[resource]
script = ExtResource("1_dlines")
entries = Array[ExtResource("2_dline")]([SubResource("Resource_intro"), SubResource("Resource_t1"), SubResource("Resource_t2"), SubResource("Resource_t3"), SubResource("Resource_t4"), SubResource("Resource_h1"), SubResource("Resource_ending"), SubResource("Resource_hint_a_d"), SubResource("Resource_hint_d_a"), SubResource("Resource_hint_d_l"), SubResource("Resource_hint_n_a"), SubResource("Resource_hint_l_n"), SubResource("Resource_n1"), SubResource("Resource_n2")])
