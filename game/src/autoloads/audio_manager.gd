extends Node
## Audio playback gate (AD-09). Nothing plays before the first user input: the title screen
## calls unlock() on that input. Buses come from res://default_bus_layout.tres, not from code.
## Music (Story 7.1): two players on the Music bus (MusicA / MusicB) crossfaded by volume; the track
## is a pure function of the flow context (desired_track).
## SFX (Story 7.2): every one-shot is a preloaded file from assets/audio/sfx/ (generated by
## tools/gen_sfx.py), played by id through play_cue on a pool of SFX_POOL_SIZE players on the SFX
## bus. The shift click keeps its dedicated ShiftSfx player (play_sfx) and the duck squeak its
## DuckSqueak player; the pool never steals them.

const GameFlow := preload("res://src/autoloads/game.gd")
const SFX_BUS := &"SFX"
const MUSIC_BUS := &"Music"
const MASTER_BUS := &"Master"
const BLIP_HZ := 880.0
const BLIP_SECONDS := 0.15
const BLIP_MIX_RATE := 22050
const BLIP_AMPLITUDE := 0.4

## Story 7.2 (D-S72-4): pooled one-shot players on the SFX bus, created together on the first cue.
const SFX_POOL_SIZE := 8
const SFX_POOL_PREFIX := "SfxPool"
## Story 7.2 (AC 1, D-S72-2, 3.1 lesson): every pooled SFX by id, preloaded (never built in a sim
## tick). The file names are final: a re-export is a file swap, not a code change. The shift clicks
## are not here (JuiceDirector preloads them via ShiftJuice and plays them on ShiftSfx).
const CUES: Dictionary[StringName, AudioStream] = {
	&"hit": preload("res://assets/audio/sfx/hit.wav"),
	&"hit_resisted": preload("res://assets/audio/sfx/hit_resisted.wav"),
	&"patched_chime": preload("res://assets/audio/sfx/patched_chime.wav"),
	&"duck_squeak": preload("res://assets/audio/sfx/duck_squeak.wav"),
	&"tell_infinite_loop": preload("res://assets/audio/sfx/tell_infinite_loop.wav"),
	&"tell_null_pointer": preload("res://assets/audio/sfx/tell_null_pointer.wav"),
	&"tell_segfault": preload("res://assets/audio/sfx/tell_segfault.wav"),
	&"glitch_infinite_loop": preload("res://assets/audio/sfx/glitch_infinite_loop.wav"),
	&"glitch_null_pointer": preload("res://assets/audio/sfx/glitch_null_pointer.wav"),
	&"glitch_segfault": preload("res://assets/audio/sfx/glitch_segfault.wav"),
	&"phase_roar": preload("res://assets/audio/sfx/phase_roar.wav"),
	&"defeat": preload("res://assets/audio/sfx/defeat.wav"),
	&"player_hit": preload("res://assets/audio/sfx/player_hit.wav"),
}
## Story 7.2 (AC 3, D-049, D-S72-3): the one tell cue per boss, by boss_index (Game.BOSS_IDS order).
## Every real-boss AttackDef.tell_sfx is one of these (test_data_validation checks it).
const BOSS_TELL_CUES: Array[StringName] = [&"tell_infinite_loop", &"tell_null_pointer", &"tell_segfault"]
## Story 7.2 (AC 4, D-S72-5): the glyph-glitch sound per boss, by boss_index.
const BOSS_GLITCH_CUES: Array[StringName] = [&"glitch_infinite_loop", &"glitch_null_pointer", &"glitch_segfault"]
## D-S72-5: the glitch plays on the phase entries with these indices (0-based, D-S71-1).
const GLITCH_SFX_PHASES: Array[int] = [1, 2]

## Story 7.1 (AC 3, B3): every music stream preloaded; the files are PLACEHOLDERS until the real
## BeepBox tracks replace them under the same names (assets/audio/music/README.md).
const TITLE_TRACK: AudioStream = preload("res://assets/audio/music/title.ogg")
const BOSS_TRACKS: Array[AudioStream] = [
	preload("res://assets/audio/music/boss_1.ogg"),
	preload("res://assets/audio/music/boss_2.ogg"),
	preload("res://assets/audio/music/boss_3.ogg"),
]
const BOSS_GLITCH_TRACKS: Array[AudioStream] = [
	preload("res://assets/audio/music/boss_1_glitch.ogg"),
	preload("res://assets/audio/music/boss_2_glitch.ogg"),
	preload("res://assets/audio/music/boss_3_glitch.ogg"),
]
const BREAKPOINT_TRACK: AudioStream = preload("res://assets/audio/music/breakpoint_muffled.ogg")
## D-S71-1: EventBus.boss_phase_changed is 0-based; the GDD's "phase 3" is index 2.
const GLITCH_PHASE_INDEX := 2
## D-S71-6 fade lengths, in 60 Hz frames.
const FLOW_FADE_FRAMES := 60
const GLITCH_FADE_FRAMES := 30
const BREAKPOINT_FADE_FRAMES := 12
## D-S71-5: HARVEST fades the music to silence.
const HARVEST_FADE_FRAMES := 30
const FRAMES_PER_SECOND := 60.0
const MUSIC_PLAYER_NAMES: Array[StringName] = [&"MusicA", &"MusicB"]

## Number of "play ignored before unlock" warnings written this session (0 or 1).
var locked_warn_count: int = 0

var _unlocked: bool = false
var _warned_locked: bool = false
var _sfx_player: AudioStreamPlayer = null
## The shift click's dedicated player (Story 2.4); a new click cuts the previous one.
var _shift_player: AudioStreamPlayer = null
## The duck squeak's own player (Story 3.6, D-S36-6): never the ShiftSfx player nor the pool.
var _squeak_player: AudioStreamPlayer = null
## Story 7.2 (D-S72-4): the pool, and the play order stamp of each player (oldest = lowest).
var _pool: Array[AudioStreamPlayer] = []
var _pool_stamps: Array[int] = []
var _pool_clock: int = 0
## Story 7.2 (AC 6, D-S72-10): ids already warned as unknown (one Log.warn per id).
var _warned_cues: Dictionary[StringName, bool] = {}
## The last cue id played through the pool (tests), and the number of unknown-id warnings.
var last_cue: StringName = &""
var unknown_cue_warn_count: int = 0
## Story 3.8 (D2, AC 1, D-S38-12): defeat squeaks requested this session, and the once-per-fight
## guard (a second boss_defeated in the same fight never squeaks twice; reset on FIGHT entry).
var defeat_squeak_count: int = 0
var _defeat_squeaked: bool = false
## Story 4.3: breakpoint_started / breakpoint_ended events handled this session (tests).
var breakpoint_music_events: int = 0
## Story 7.1 (D-S71-7): the music context. The wanted track is desired_track() of these four.
var music_flow: int = GameFlow.FlowState.TITLE
var music_boss_index: int = 0
var music_glitch: bool = false
var music_breakpoint: bool = false
## Number of crossfade_to calls that changed the music this session (tests).
var music_switch_count: int = 0

## MusicA / MusicB, created on the first music request after unlock; never more than two.
var _music_players: Array[AudioStreamPlayer] = []
var _music_tweens: Array[Tween] = [null, null]
## Index into _music_players of the player that carries the current track (-1: none yet).
var _music_active: int = -1
## The track the active player is playing or fading in (null: silence).
var _music_track: AudioStream = null


func _ready() -> void:
	EventBus.boss_tell_started.connect(_on_boss_tell_started)
	EventBus.hit_landed.connect(_on_hit_landed)
	EventBus.patched_applied.connect(_on_patched_applied)
	EventBus.player_damaged.connect(_on_player_damaged)
	EventBus.boss_roar_started.connect(_on_boss_roar_started)
	EventBus.boss_defeated.connect(on_boss_defeated)
	EventBus.flow_state_changed.connect(_on_flow_state_changed)
	EventBus.breakpoint_started.connect(on_breakpoint_started)
	EventBus.breakpoint_ended.connect(on_breakpoint_ended)
	EventBus.boss_phase_changed.connect(on_boss_phase_changed)


## Story 3.8 (D2, AC 1): the duck squeaks once when the boss is defeated. Presentation only.
## Story 7.2 (AC 4, D-S72-5): the defeat stinger plays on every boss_defeated (pooled).
func on_boss_defeated(_boss: StringName) -> void:
	if _defeat_squeaked:
		return # a duplicate boss_defeated plays neither the stinger nor the squeak again
	_defeat_squeaked = true
	play_cue(&"defeat")
	defeat_squeak_count += 1
	play_squeak()


## Story 4.3 / 7.1 (AC 8, 9): Breakpoint switches to the muffled loop and back, on the bar.
func on_breakpoint_started() -> void:
	breakpoint_music_events += 1
	music_breakpoint = true
	_apply_music(BREAKPOINT_FADE_FRAMES)


func on_breakpoint_ended() -> void:
	breakpoint_music_events += 1
	music_breakpoint = false
	_apply_music(BREAKPOINT_FADE_FRAMES)


## Story 7.1 (AC 5, 6, 9): the third phase (index 2) wants the glitch variant. During Breakpoint the
## flag only changes; the switch happens when Breakpoint ends (D-S71-7).
## Story 7.2 (AC 4, D-S72-5): phase entries 1 and 2 play the boss's glyph-glitch sound.
func on_boss_phase_changed(phase: int) -> void:
	if music_flow != GameFlow.FlowState.FIGHT:
		return # a late phase event during DEAD / HARVEST must not switch the music
	if _unlocked and phase in GLITCH_SFX_PHASES: # a context change before unlock stays silent (7.1)
		var glitch: StringName = glitch_cue(music_boss_index)
		if glitch != &"":
			play_cue(glitch)
	music_glitch = phase >= GLITCH_PHASE_INDEX
	_apply_music(GLITCH_FADE_FRAMES)


func _on_flow_state_changed(from: int, to: int) -> void:
	if to == GameFlow.FlowState.FIGHT:
		_defeat_squeaked = false
	on_music_flow_changed(from, to, Game.run.boss_index)


## Story 7.1 (AC 1, 7, 10, D-S71-3..6): the music side of a flow change. `boss_index` is read from
## Game by the caller (presentation reads sim state, never writes it).
func on_music_flow_changed(from: int, to: int, boss_index: int) -> void:
	music_flow = to
	match to:
		GameFlow.FlowState.FIGHT:
			# D-S71-4: every FIGHT entry (first start or retry) restarts the base track from 0;
			# a retry cuts at once, any other entry crossfades from what was playing.
			music_boss_index = boss_index
			music_glitch = false
			music_breakpoint = false
			var frames: int = 0 if from == GameFlow.FlowState.DEAD else FLOW_FADE_FRAMES
			_apply_music(frames, true)
		GameFlow.FlowState.HARVEST:
			_apply_music(HARVEST_FADE_FRAMES)
		GameFlow.FlowState.ENDING:
			_apply_music(FLOW_FADE_FRAMES, true)
		_:
			_apply_music(FLOW_FADE_FRAMES)


## Story 7.1 (AC 11, D-S71-7): pure. The track the context wants; null is silence. TITLE, INTRO and
## ENDING want the title track; FIGHT wants the boss track (glitch at phase 3), or the muffled loop
## during Breakpoint; DEAD keeps the fight track; HARVEST is silent.
static func desired_track(flow: int, boss_index: int, glitch: bool, breakpoint_active: bool) -> AudioStream:
	match flow:
		GameFlow.FlowState.TITLE, GameFlow.FlowState.INTRO, GameFlow.FlowState.ENDING:
			return TITLE_TRACK
		GameFlow.FlowState.FIGHT, GameFlow.FlowState.DEAD:
			if flow == GameFlow.FlowState.FIGHT and breakpoint_active:
				return BREAKPOINT_TRACK
			if boss_index < 0 or boss_index >= BOSS_TRACKS.size():
				return null
			return BOSS_GLITCH_TRACKS[boss_index] if glitch else BOSS_TRACKS[boss_index]
	return null


## The track the current context wants (desired_track of the four music fields).
func wanted_track() -> AudioStream:
	return desired_track(music_flow, music_boss_index, music_glitch, music_breakpoint)


## The track currently playing or fading in (null: silence).
func current_track() -> AudioStream:
	return _music_track


## The player carrying the current track, or null before the first music request.
func active_music_player() -> AudioStreamPlayer:
	return _music_players[_music_active] if _music_active >= 0 else null


## Moves the music to wanted_track(). Before unlock the context changes silently (the title
## screen's unlock() starts the music); `restart` replays the track from 0 even if it is current.
func _apply_music(frames: int, restart: bool = false) -> void:
	if not _unlocked:
		return
	var track: AudioStream = wanted_track()
	if track == _music_track and not restart:
		return
	crossfade_to(track, frames, not restart)


## Story 7.1 (AC 2, D-S71-8): crossfades to `track` over `frames` (60 Hz) on the two Music players,
## alternating. With `sync` the new track starts at the old one's playback position (modulo its
## length), so a variant stays on the bar; otherwise it starts from 0. A null track fades to
## silence. The outgoing player stops when its fade ends. Ignored (warn once) before unlock.
func crossfade_to(track: AudioStream, frames: int, sync: bool = true) -> void:
	if not _unlocked:
		_warn_locked_once()
		return
	_ensure_music_players()
	var outgoing: AudioStreamPlayer = active_music_player()
	var position: float = 0.0
	if sync and outgoing != null and outgoing.playing:
		position = outgoing.get_playback_position()
	var seconds: float = maxf(float(frames), 0.0) / FRAMES_PER_SECOND
	if outgoing != null:
		_fade(_music_active, 0.0, seconds, true)
	_music_track = track
	music_switch_count += 1
	Log.debug(&"audio", "music -> %s (%d frames)" % [_track_name(track), frames])
	if track == null:
		return
	_music_active = 0 if _music_active < 0 else 1 - _music_active
	var incoming: AudioStreamPlayer = _music_players[_music_active]
	_kill_tween(_music_active)
	incoming.stop()
	incoming.stream = track
	var length: float = track.get_length()
	position = fmod(position, length) if length > 0.0 else 0.0
	incoming.volume_linear = 0.0 if seconds > 0.0 else 1.0
	incoming.play(position)
	if seconds > 0.0:
		_fade(_music_active, 1.0, seconds, false)


func _ensure_music_players() -> void:
	if not _music_players.is_empty():
		return
	for player_name: StringName in MUSIC_PLAYER_NAMES:
		var player := AudioStreamPlayer.new()
		player.name = player_name
		player.bus = MUSIC_BUS
		add_child(player)
		_music_players.append(player)


## Tweens player `index` to `target` linear volume; `stop_after` stops it at the end (fade-out).
func _fade(index: int, target: float, seconds: float, stop_after: bool) -> void:
	_kill_tween(index)
	var player: AudioStreamPlayer = _music_players[index]
	if seconds <= 0.0:
		player.volume_linear = target
		if stop_after:
			player.stop()
		return
	var tween: Tween = create_tween()
	tween.tween_property(player, ^"volume_linear", target, seconds)
	if stop_after:
		tween.tween_callback(player.stop)
	_music_tweens[index] = tween


func _kill_tween(index: int) -> void:
	var tween: Tween = _music_tweens[index]
	if tween != null and tween.is_valid():
		tween.kill()
	_music_tweens[index] = null


static func _track_name(track: AudioStream) -> String:
	return "silence" if track == null else track.resource_path.get_file()


## Story 3.1 (AC 4) / 7.2 (AC 3, D-S72-10): every boss tell plays its cue by id on the SFX pool.
## An unknown id plays nothing and warns once (play_cue). Presentation only.
func _on_boss_tell_started(_attack_id: StringName, tell_sfx: StringName) -> void:
	play_cue(tell_sfx)


## Story 7.2 (AC 5, D-S72-6): a boss hit plays `hit` in the BASE state and `hit_resisted` in the
## UNPATCHED state; a PATCHED hit adds nothing (the chime of patched_applied is its cue).
func _on_hit_landed(target: StringName, _damage: int, state: int, _is_combo: bool, _pos: Vector2) -> void:
	var cue: StringName = hit_cue(target, state)
	if cue != &"":
		play_cue(cue)


## Pure: the hit cue for a hit on `target` in damage `state` (&"" = none).
static func hit_cue(target: StringName, state: int) -> StringName:
	if target != &"boss":
		return &""
	match state:
		DamageState.Kind.BASE:
			return &"hit"
		DamageState.Kind.UNPATCHED:
			return &"hit_resisted"
	return &""


## Pure: the glyph-glitch cue of boss `boss_index` (&"" when out of range).
static func glitch_cue(boss_index: int) -> StringName:
	if boss_index < 0 or boss_index >= BOSS_GLITCH_CUES.size():
		return &""
	return BOSS_GLITCH_CUES[boss_index]


## Story 3.2 (AC 5) / 7.2: Patched applied plays the rising chime.
func _on_patched_applied(_boss: StringName, _frames: int) -> void:
	play_cue(&"patched_chime")


## Story 7.2 (AC 5): the player takes damage.
func _on_player_damaged(_hp: int) -> void:
	play_cue(&"player_hit")


## Story 7.2 (AC 4, D-S72-5): the phase roar.
func _on_boss_roar_started(_phase: int) -> void:
	play_cue(&"phase_roar")


## Story 7.2 (AC 6, D-S72-4, D-S72-10): plays cue `id` on the SFX pool. Ignored before unlock (warn
## once, the 1.4 rule). An unknown id plays nothing and logs one Log.warn per id. The pool is
## created at unlock; a free player is used, else the oldest one is stolen.
func play_cue(id: StringName) -> void:
	if not _unlocked:
		_warn_locked_once()
		return
	var stream: AudioStream = CUES.get(id, null)
	if stream == null:
		if not _warned_cues.has(id):
			_warned_cues[id] = true
			unknown_cue_warn_count += 1
			Log.warn(&"audio", "unknown sfx cue '%s'" % id)
		return
	_ensure_pool()
	var index: int = _pick_pool_player()
	var player: AudioStreamPlayer = _pool[index]
	_pool_clock += 1
	_pool_stamps[index] = _pool_clock
	player.stream = stream
	player.play()
	last_cue = id


## The pool players (empty before the first cue).
func pool_players() -> Array[AudioStreamPlayer]:
	return _pool


func _ensure_pool() -> void:
	if not _pool.is_empty():
		return
	for i: int in SFX_POOL_SIZE:
		var player := AudioStreamPlayer.new()
		player.name = "%s%d" % [SFX_POOL_PREFIX, i]
		player.bus = SFX_BUS
		add_child(player)
		_pool.append(player)
		_pool_stamps.append(0)


## The least recently started free player, or the least recently started one when all play.
func _pick_pool_player() -> int:
	var best: int = -1
	for i: int in _pool.size():
		if not _pool[i].playing and (best < 0 or _pool_stamps[i] < _pool_stamps[best]):
			best = i
	if best >= 0:
		return best
	best = 0
	for i: int in _pool.size():
		if _pool_stamps[i] < _pool_stamps[best]:
			best = i
	return best


func unlock() -> void:
	if _unlocked:
		return
	_unlocked = true
	Log.info(&"audio", "unlocked")
	_ensure_pool() # built here, on the first input, never inside a sim tick (the 3.1 lesson)
	_apply_music(0) # Story 7.1 (AC 1, D-S71-3): the title track starts on the first input


func is_unlocked() -> bool:
	return _unlocked


## Master bus mute for the session (Story 1.7 AC3, DC8). AudioServer holds the value, so the
## save service (7.3) can read it back; nothing is written to disk here. Logs once per change.
func set_master_muted(muted: bool) -> void:
	var bus: int = AudioServer.get_bus_index(MASTER_BUS)
	if bus < 0 or AudioServer.is_bus_mute(bus) == muted:
		return
	AudioServer.set_bus_mute(bus, muted)
	Log.info(&"audio", "master %s" % ("muted" if muted else "unmuted"))


func is_master_muted() -> bool:
	var bus: int = AudioServer.get_bus_index(MASTER_BUS)
	return bus >= 0 and AudioServer.is_bus_mute(bus)


## Story 1.4 test SFX (DC4): a generated blip on the SFX bus. Ignored before unlock.
func play_test_sfx() -> void:
	if not _unlocked:
		_warn_locked_once()
		return
	if _sfx_player == null:
		_sfx_player = AudioStreamPlayer.new()
		_sfx_player.name = &"TestSfx"
		_sfx_player.bus = SFX_BUS
		_sfx_player.stream = make_blip()
		add_child(_sfx_player)
	_sfx_player.play()


## Plays `stream` on the dedicated ShiftSfx player (Story 2.4 shift click, D-S24-8, FR28): called
## on the input frame, never deferred. Ignored before unlock. A rapid second call restarts it; the
## pool (play_cue) never uses this player (Story 7.2, AC 6).
func play_sfx(stream: AudioStream) -> void:
	if not _unlocked:
		_warn_locked_once()
		return
	if stream == null:
		return
	if _shift_player == null:
		_shift_player = AudioStreamPlayer.new()
		_shift_player.name = &"ShiftSfx"
		_shift_player.bus = SFX_BUS
		add_child(_shift_player)
	_shift_player.stream = stream
	_shift_player.play()


## Story 3.6 (D-046, D-S36-6): the duck squeak on every bubble line start, on its own lazily
## created `DuckSqueak` player on the SFX bus. Ignored before unlock (the same warn-once rule).
func play_squeak() -> void:
	if not _unlocked:
		_warn_locked_once()
		return
	if _squeak_player == null:
		_squeak_player = AudioStreamPlayer.new()
		_squeak_player.name = &"DuckSqueak"
		_squeak_player.bus = SFX_BUS
		_squeak_player.stream = CUES[&"duck_squeak"] # Story 7.2: the final squeak
		add_child(_squeak_player)
	_squeak_player.play()


## 16-bit mono sine blip, no loop, short linear fade-out to avoid a click. Story 1.4 test SFX
## (the title start press); every gameplay sound is a file since Story 7.2.
static func make_blip() -> AudioStreamWAV:
	var frames: int = int(BLIP_SECONDS * BLIP_MIX_RATE)
	var data := PackedByteArray()
	data.resize(frames * 2)
	for i: int in frames:
		var fade: float = 1.0 - float(i) / float(frames)
		var sample: float = sin(TAU * BLIP_HZ * float(i) / float(BLIP_MIX_RATE)) * BLIP_AMPLITUDE * fade
		data.encode_s16(i * 2, int(sample * 32767.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.stereo = false
	wav.mix_rate = BLIP_MIX_RATE
	wav.loop_mode = AudioStreamWAV.LOOP_DISABLED
	wav.data = data
	return wav


func _warn_locked_once() -> void:
	if _warned_locked:
		return
	_warned_locked = true
	locked_warn_count += 1
	Log.warn(&"audio", "play ignored before unlock")
