; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="GitHub Game Off 2026"
run/main_scene="res://src/main/main.tscn"
run/max_fps=60
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

general/default_playback_type.web=1

[autoload]

Log="*res://src/autoloads/log.gd"
EventBus="*res://src/autoloads/event_bus.gd"
SimClock="*res://src/autoloads/sim_clock.gd"
Game="*res://src/autoloads/game.gd"
Debug="*res://src/autoloads/debug.gd"
AudioManager="*res://src/autoloads/audio_manager.gd"
VoiceService="*res://src/autoloads/voice_service.gd"
SaveService="*res://src/autoloads/save_service.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"

